# Signs login cookies. Any long random string, e.g. `openssl rand -base64 32`.
AUTH_SECRET=
# PINs staff type on the sign-in page.
HOUSEKEEPING_PIN=
FRONTDESK_PIN=
# Administrator sign-in. Leave unset to disable the Administrator role.
ADMIN_PIN=
# Added automatically when you connect Redis to the Vercel project. Either one works.
REDIS_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: Vercel sends this to the daily backup cron; other callers are refused when it is set.
CRON_SECRET=
# Optional: fill an empty store with demo rooms (always on in local development).
HK_SEED_DEMO=
